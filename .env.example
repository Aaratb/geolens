# Copy to .env.local and fill in real values. Never commit real values.

# Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Database (Neon Postgres)
# Pooled connection for app runtime
DATABASE_URL=
# Direct connection for migrations
DIRECT_URL=

# Cache / rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Blob storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# AI (Vercel AI Gateway routes openai/anthropic/perplexity/gemini under one key)
AI_GATEWAY_API_KEY=

# SEO (Google PageSpeed Insights)
PAGESPEED_INSIGHTS_API_KEY=

# App secrets
IP_HASH_SALT=                     # rotate yearly
SHARE_TOKEN_SECRET=

# Limits (overridable per env)
DAILY_LLM_BUDGET_USD=50
PER_SCAN_COST_CEILING_CENTS=20

# Scan profile — "hobby" (default, fits Vercel Hobby's 60s function timeout
# by skipping multi-page crawl + dropping Perplexity Sonar) or "pro" (full
# scope: 5 internal pages, all 4 engines, 25s probe timeout).
SCAN_PROFILE=hobby

# Cron
CRON_SECRET=
